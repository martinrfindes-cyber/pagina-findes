    {
      "id": "eafdc1a9-f068-474d-9fc8-55f52d5fcd50",
      "name": "Evaluar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        380
      ],
      "parameters": {
        "jsCode": "\nconst ok = (r) => r && typeof r.statusCode === 'number' && r.statusCode >= 200 && r.statusCode < 400;\nfunction get(name){ try { return $(name).first().json; } catch(e){ return null; } }\n\nconst web = get('Revisar web');\nconst chatwoot = get('Revisar Chatwoot');\nlet botRecheck = null, fixAttempted = false;\ntry { botRecheck = $('Re-revisar bot').first().json; fixAttempted = true; } catch(e){}\n\nconst fails = [];\nconst fixes = [];\n\nif (!ok(web)) {\n  fails.push('- La web *automatizai.com.mx* no responde (codigo ' + (web && web.statusCode ? web.statusCode : 'sin respuesta') + ').');\n}\nif (!ok(chatwoot)) {\n  fails.push('- *Chatwoot* no responde (codigo ' + (chatwoot && chatwoot.statusCode ? chatwoot.statusCode : 'sin respuesta') + ').');\n}\nif (fixAttempted) {\n  if (ok(botRecheck)) {\n    fixes.push('- El *chatbot* (AUTOMATIZAI-CHATWOOT) estaba caido; lo reactive automaticamente y ya responde.');\n  } else {\n    const s = (botRecheck && botRecheck.statusCode ? botRecheck.statusCode : 'sin respuesta');\n    fails.push('- El *chatbot* SIGUE caido tras intentar reactivarlo (webhook ' + s + '). Revisalo tu.');\n  }\n}\n\nif (fails.length === 0 && fixes.length === 0) {\n  return [];\n}\n\nlet parts = [];\nif (fails.length) parts.push('Problemas:\\n' + fails.join('\\n'));\nif (fixes.length) parts.push('Auto-arreglos:\\n' + fixes.join('\\n'));\nconst header = fails.length ? '🚨 *Alerta AutomatizAI*' : '🔧 *Auto-arreglo AutomatizAI*';\nconst text = header + '\\n\\n' + parts.join('\\n\\n') + '\\n\\n_Monitor cada 3 h._';\nreturn [{ json: { text: text } }];\n"
      }
    },
    {
